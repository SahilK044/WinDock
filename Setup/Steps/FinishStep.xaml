<UserControl x:Class="WinDockSetup.Steps.FinishStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             Loaded="UserControl_Loaded">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Standalone Perfectly Centered Checkmark Icon -->
            <Viewbox Width="54" Height="54" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Path x:Name="CheckmarkPath" 
                      Data="M 3 13.5 L 9 19.5 L 21 6.5" 
                      Stroke="#2563EB" 
                      StrokeThickness="3.5" 
                      StrokeEndLineCap="Round" 
                      StrokeStartLineCap="Round" 
                      StrokeLineJoin="Round"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <ScaleTransform x:Name="CheckmarkScale" ScaleX="1.0" ScaleY="1.0" />
                    </Path.RenderTransform>
                </Path>
            </Viewbox>

            <!-- Title -->
            <TextBlock x:Name="TitleText"
                       Text="WinDock Suite is Ready" 
                       FontFamily="{DynamicResource DisplayFontFamily}" 
                       FontSize="26" FontWeight="Bold"
                       Foreground="#0F172A" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,8"
                       Opacity="0" />

            <!-- Subtitle -->
            <TextBlock x:Name="SubtitleText"
                       Text="WinDock, Winland, and Weather App installed successfully." 
                       FontFamily="{DynamicResource BodyFontFamily}" 
                       FontSize="14" 
                       Foreground="#475569" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,24"
                       Opacity="0" />

            <!-- CheckBox -->
            <CheckBox x:Name="LaunchCheckBox"
                      Content="Launch WinDock Suite now"
                      IsChecked="True"
                      Style="{StaticResource CyanCheckBoxStyle}"
                      HorizontalAlignment="Center"
                      Opacity="0" />
        </StackPanel>

        <!-- Bottom Button Row -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Button x:Name="FinishButton" 
                    Content="Launch &amp; Finish" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    HorizontalAlignment="Right" 
                    Click="FinishButton_Click"
                    Opacity="0" />
        </Grid>
    </Grid>
</UserControl>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         DESIGN TOKENS  ·  WinDock Minimalist Setup
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Base Brushes (Clean Light Mode) -->
    <SolidColorBrush x:Key="GraphiteVoidBrush"          Color="#F8FAFC"/>
    <SolidColorBrush x:Key="FrostPanelBackgroundBrush"  Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FrostPanelBorderBrush"      Color="#E2E8F0"/>

    <!-- Accent Color: Royal Blue Glow -->
    <SolidColorBrush x:Key="TelemetryCyanBrush"         Color="#2563EB"/>
    <SolidColorBrush x:Key="TelemetryCyan26Brush"       Color="#1F2563EB"/>
    <SolidColorBrush x:Key="OceanCyanBrush"             Color="#1D4ED8"/>
    <SolidColorBrush x:Key="PodiumGoldBrush"            Color="#D97706"/>
    <SolidColorBrush x:Key="SignalRedBrush"             Color="#DC2626"/>

    <!-- Text Hierarchy (High Contrast Slate/Charcoal) -->
    <SolidColorBrush x:Key="FogWhiteBrush"              Color="#0F172A"/>
    <SolidColorBrush x:Key="FogWhite70Brush"            Color="#475569"/>
    <SolidColorBrush x:Key="FogWhite45Brush"            Color="#64748B"/>

    <!-- Overlays -->
    <SolidColorBrush x:Key="HoverOverlayBrush"          Color="#0F000000"/>
    <SolidColorBrush x:Key="PressOverlayBrush"          Color="#1A000000"/>

    <!-- Colors -->
    <Color x:Key="TelemetryCyanColor">#2563EB</Color>
    <Color x:Key="OceanCyanColor">#1D4ED8</Color>
    <Color x:Key="PodiumGoldColor">#D97706</Color>
    <Color x:Key="SignalRedColor">#DC2626</Color>
    <Color x:Key="GraphiteVoidColor">#F8FAFC</Color>
    <Color x:Key="FogWhiteColor">#0F172A</Color>
    <Color x:Key="FrostPanelBgColor">#FFFFFF</Color>
    <Color x:Key="StepDotInactiveColor">#CBD5E1</Color>

    <!-- Typography -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, Cascadia Code, monospace</FontFamily>

    <!-- Radii -->
    <CornerRadius x:Key="WindowCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">10</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">10</CornerRadius>

    <!-- Linear Gradients -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlassCardBackgroundBrush" Color="#FFFFFF"/>

    <!-- ── Primary Action Button ──────────────────────────────────── -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#059669"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#047857"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ghost / Secondary Button ───────────────────────────────── -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource FogWhite70Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource FrostPanelBorderBrush}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Styled TextBox (for path input) ────────────────────────── -->
    <Style x:Key="FrostTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource FrostPanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FrostPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CaretBrush" Value="{StaticResource TelemetryCyanBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource TelemetryCyanBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource InputCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource TelemetryCyanBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Custom CheckBox ──────────────────────────────────── -->
    <Style x:Key="CyanCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="#0F172A"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box"
                                Width="18" Height="18"
                                CornerRadius="5"
                                BorderThickness="1.5"
                                BorderBrush="#CBD5E1"
                                Background="#FFFFFF"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Viewbox Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="Check"
                                      Data="M 2,7 L 6,11 L 14,3"
                                      Stroke="#FFFFFF"
                                      StrokeThickness="2.5"
                                      StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Opacity="0"/>
                            </Viewbox>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="#2563EB"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="#2563EB"/>
                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="#94A3B8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

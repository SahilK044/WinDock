<UserControl x:Class="WinDockSetup.Steps.ProgressStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <Storyboard x:Key="SmoothShimmerStoryboard" RepeatBehavior="Forever" Timeline.DesiredFrameRate="60">
            <PointAnimation Storyboard.TargetName="ShimmerGradient"
                            Storyboard.TargetProperty="StartPoint"
                            From="-1.5,0" To="1.5,0"
                            Duration="0:0:1.5"/>
            <PointAnimation Storyboard.TargetName="ShimmerGradient"
                            Storyboard.TargetProperty="EndPoint"
                            From="-0.5,0" To="2.5,0"
                            Duration="0:0:1.5"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid Margin="12,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
            <RowDefinition Height="Auto"/> <!-- Row 1: Glowing Progress Bar Card -->
            <RowDefinition Height="*"/>    <!-- Row 2: Console Log -->
            <RowDefinition Height="Auto"/> <!-- Row 3: Buttons -->
        </Grid.RowDefinitions>

        <!-- Row 0: Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock x:Name="TitleText"
                       Text="Installing WinDock Suite"
                       FontFamily="{StaticResource DisplayFontFamily}"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#0F172A"
                       Margin="0,0,0,4"/>

            <TextBlock x:Name="StatusText"
                       Text="Preparing installation directory..."
                       FontFamily="{StaticResource BodyFontFamily}"
                       FontSize="13.5"
                       Foreground="#475569"/>
        </StackPanel>

        <!-- Row 1: Progress Card with Shimmer & Live File Label -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="20,16"
                Margin="0,0,0,14">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="INSTALLATION PROGRESS"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="9.5"
                               FontWeight="Bold"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>

                    <TextBlock x:Name="PercentText"
                               Text="0%"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="13"
                               FontWeight="Bold"
                               Foreground="#2563EB"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- Progress Bar Container -->
                <Grid x:Name="ProgressTrackContainer" Height="10" Margin="0,0,0,10">
                    <!-- Track Background -->
                    <Border CornerRadius="5" Background="#E2E8F0"/>
                    
                    <!-- Progress Fill Container -->
                    <Border x:Name="ProgressBarFill"
                            HorizontalAlignment="Left"
                            Width="0"
                            CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush x:Name="ShimmerGradient" StartPoint="-1.5,0" EndPoint="-0.5,0">
                                <GradientStop Color="#1D4ED8" Offset="0.0"/>
                                <GradientStop Color="#2563EB" Offset="0.3"/>
                                <GradientStop Color="#BFDBFE" Offset="0.5"/>
                                <GradientStop Color="#2563EB" Offset="0.7"/>
                                <GradientStop Color="#1D4ED8" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Live File Being Copied Label -->
                <TextBlock x:Name="CurrentFileText"
                           Text="Copying files..."
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11"
                           Foreground="#2563EB"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Row 2: Console Log -->
        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16,14"
                Margin="0,0,0,16">
            <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                <TextBlock x:Name="LogText"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="11"
                           Foreground="#475569"
                           TextWrapping="Wrap"
                           LineHeight="18"/>
            </ScrollViewer>
        </Border>

        <!-- Row 3: Action Buttons -->
        <Grid Grid.Row="3" Margin="0,0,0,0">
            <Button x:Name="CancelBtn"
                    Content="Cancel"
                    Style="{StaticResource GhostButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="CancelBtn_Click"/>

            <Button x:Name="RetryBtn"
                    Content="Retry Installation"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HorizontalAlignment="Right"
                    Click="RetryBtn_Click"
                    Visibility="Collapsed"/>
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="WinDockSetup.Steps.OptionsStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600"
             Background="Transparent">
             
    <UserControl.Resources>
        <ControlTemplate TargetType="CheckBox" x:Key="ToggleSwitchStyle">
            <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand">
                <Grid Width="42" Height="22">
                    <Border x:Name="TrackOff" CornerRadius="11" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" />
                    <Border x:Name="TrackOn" CornerRadius="11" Background="#2563EB" BorderThickness="0" Opacity="0" />
                    <Border x:Name="Thumb" Width="16" Height="16" CornerRadius="8" Background="#FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                        </Border.Effect>
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="ThumbTranslate" X="0" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>
                <TextBlock Text="{TemplateBinding Content}" FontFamily="{StaticResource BodyFontFamily}" FontSize="13.5" Foreground="#0F172A" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbTranslate" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid Margin="12,0,12,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <TextBlock Text="Installation Options" FontFamily="{StaticResource DisplayFontFamily}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20" />
        
        <StackPanel Grid.Row="1">
            <TextBlock Text="INSTALLATION PATH" FontFamily="{StaticResource MonoFontFamily}" FontSize="10.5" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8" />
            
            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <TextBox x:Name="PathTextBox" 
                         FontFamily="{StaticResource BodyFontFamily}" FontSize="13" Foreground="#0F172A"
                         Background="#FFFFFF" BorderBrush="#CBD5E1"
                         BorderThickness="1" Padding="12,10" VerticalContentAlignment="Center" TextChanged="PathTextBox_TextChanged">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="{StaticResource InputCornerRadius}" />
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                
                <Button Grid.Column="1" Margin="8,0,0,0" Style="{StaticResource GhostButtonStyle}" Content="Browse" Click="BrowseButton_Click" />
            </Grid>
            
            <TextBlock x:Name="DiskSpaceTextBlock" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="#64748B" Margin="0,0,0,20" />
            
            <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20,18">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.06" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <CheckBox x:Name="StartupToggle" Content="Launch WinDock on startup" Template="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,16" />
                    <CheckBox x:Name="StartMenuToggle" Content="Create Start Menu shortcut" Template="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,16" />
                    <CheckBox x:Name="DesktopShortcutToggle" Content="Create Desktop shortcut" Template="{StaticResource ToggleSwitchStyle}" IsChecked="True" Margin="0,0,0,16" />
                    <CheckBox x:Name="UpdatesToggle" Content="Check for automatic updates" Template="{StaticResource ToggleSwitchStyle}" IsChecked="True" />
                </StackPanel>
            </Border>
        </StackPanel>
        
        <Grid Grid.Row="2" Margin="0,24,0,0">
            <Button HorizontalAlignment="Left" Style="{StaticResource GhostButtonStyle}" Content="← Back" Click="BackButton_Click" />
            
            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButtonStyle}" Content="Install WinDock" Click="InstallButton_Click" />
        </Grid>
    </Grid>
</UserControl>

<UserControl x:Class="WinDockSetup.Steps.FinishStep"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="600"
             Loaded="UserControl_Loaded">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
            
            <!-- Checkmark Icon in glowing circle -->
            <Border Width="64" Height="64" CornerRadius="32" Background="#1A10B981" BorderBrush="#3310B981" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Viewbox Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="CheckmarkPath" 
                          Data="M 5,13 L 10,18 L 20,7" 
                          Stroke="{DynamicResource TelemetryCyanBrush}" 
                          StrokeThickness="2.5" 
                          StrokeEndLineCap="Round" 
                          StrokeStartLineCap="Round" 
                          StrokeLineJoin="Round"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <ScaleTransform x:Name="CheckmarkScale" ScaleX="1.0" ScaleY="1.0" />
                        </Path.RenderTransform>
                    </Path>
                </Viewbox>
            </Border>

            <!-- Title -->
            <TextBlock x:Name="TitleText"
                       Text="WinDock is Ready" 
                       FontFamily="{DynamicResource DisplayFontFamily}" 
                       FontSize="24" FontWeight="Bold"
                       Foreground="{DynamicResource FogWhiteBrush}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,8"
                       Opacity="0" />

            <!-- Subtitle -->
            <TextBlock x:Name="SubtitleText"
                       Text="Installation completed successfully." 
                       FontFamily="{DynamicResource BodyFontFamily}" 
                       FontSize="14" 
                       Foreground="{DynamicResource FogWhite70Brush}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,24"
                       Opacity="0" />

            <!-- CheckBox -->
            <CheckBox x:Name="LaunchCheckBox"
                      Content="Launch WinDock now"
                      IsChecked="True"
                      Style="{StaticResource CyanCheckBoxStyle}"
                      HorizontalAlignment="Center"
                      Opacity="0" />
        </StackPanel>

        <!-- Bottom Button Row -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Button x:Name="FinishButton" 
                    Content="Launch &amp; Finish" 
                    Style="{StaticResource PrimaryButtonStyle}" 
                    HorizontalAlignment="Right" 
                    Click="FinishButton_Click"
                    Opacity="0" />
        </Grid>
    </Grid>
</UserControl>

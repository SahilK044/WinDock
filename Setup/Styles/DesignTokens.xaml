<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════
         DESIGN TOKENS  ·  WinDock Minimalist Setup
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Base Brushes -->
    <SolidColorBrush x:Key="GraphiteVoidBrush"          Color="#090A0F"/>
    <SolidColorBrush x:Key="FrostPanelBackgroundBrush"  Color="#12151C"/>
    <SolidColorBrush x:Key="FrostPanelBorderBrush"      Color="#1F2530"/>

    <!-- Accent Color: Emerald Glow -->
    <SolidColorBrush x:Key="TelemetryCyanBrush"         Color="#10B981"/>
    <SolidColorBrush x:Key="TelemetryCyan26Brush"       Color="#2610B981"/>
    <SolidColorBrush x:Key="PodiumGoldBrush"            Color="#F59E0B"/>
    <SolidColorBrush x:Key="SignalRedBrush"             Color="#EF4444"/>

    <!-- Text Hierarchy -->
    <SolidColorBrush x:Key="FogWhiteBrush"              Color="#F9FAFB"/>
    <SolidColorBrush x:Key="FogWhite70Brush"            Color="#9CA3AF"/>
    <SolidColorBrush x:Key="FogWhite45Brush"            Color="#6B7280"/>

    <!-- Overlays -->
    <SolidColorBrush x:Key="HoverOverlayBrush"          Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="PressOverlayBrush"          Color="#26FFFFFF"/>

    <!-- Colors -->
    <Color x:Key="TelemetryCyanColor">#10B981</Color>
    <Color x:Key="PodiumGoldColor">#F59E0B</Color>
    <Color x:Key="SignalRedColor">#EF4444</Color>
    <Color x:Key="GraphiteVoidColor">#090A0F</Color>
    <Color x:Key="FogWhiteColor">#F9FAFB</Color>
    <Color x:Key="FrostPanelBgColor">#12151C</Color>
    <Color x:Key="StepDotInactiveColor">#26FFFFFF</Color>

    <!-- Typography -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFontFamily">Consolas, monospace</FontFamily>

    <!-- Radii -->
    <CornerRadius x:Key="WindowCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="CardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ButtonCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="InputCornerRadius">8</CornerRadius>

    <!-- ── Primary Action Button ──────────────────────────────────── -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource TelemetryCyanBrush}"/>
        <Setter Property="Foreground" Value="#090A0F"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="24,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#059669"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.02" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.02" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1.0" Duration="0:0:0.1"/>
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1.0" Duration="0:0:0.1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#047857"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ghost / Secondary Button ───────────────────────────────── -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource FogWhite70Brush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{StaticResource ButtonCornerRadius}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource FrostPanelBorderBrush}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverOverlayBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource PressOverlayBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Styled TextBox (for path input) ────────────────────────── -->
    <Style x:Key="FrostTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource FrostPanelBackgroundBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource FrostPanelBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="CaretBrush" Value="{StaticResource TelemetryCyanBrush}"/>
        <Setter Property="SelectionBrush" Value="{StaticResource TelemetryCyanBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource InputCornerRadius}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource TelemetryCyanBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Custom CheckBox ──────────────────────────────────── -->
    <Style x:Key="CyanCheckBoxStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource FogWhiteBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="Box"
                                Width="20" Height="20"
                                CornerRadius="5"
                                BorderThickness="1.5"
                                BorderBrush="{StaticResource FrostPanelBorderBrush}"
                                Background="Transparent"
                                VerticalAlignment="Center"
                                Margin="0,0,10,0">
                            <Path x:Name="Check"
                                  Data="M 4,10 L 8,14 L 15,6"
                                  Stroke="{StaticResource GraphiteVoidBrush}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Opacity="0"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Center"/>
                        </Border>
                        <ContentPresenter VerticalAlignment="Center"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{StaticResource TelemetryCyanBrush}"/>
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TelemetryCyanBrush}"/>
                            <Setter TargetName="Check" Property="Opacity" Value="1"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FogWhite70Brush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

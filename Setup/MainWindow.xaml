<Window x:Class="WinDockSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Height="540"
        Width="760"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Border CornerRadius="16"
            BorderThickness="1"
            BorderBrush="#E2E8F0"
            Background="#F8FAFC"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Row 0 — Clean Title Bar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="#05000000">
                <!-- macOS Style Traffic Lights / Left Window Controls -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FF5F56" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="CloseBtn_Click"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#FFBD2E" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonDown="MinBtn_Click"/>
                    <Border Width="12" Height="12" CornerRadius="6" Background="#27C93F"/>
                </StackPanel>

                <!-- Centered Title -->
                <TextBlock Text="WinDock Installer" 
                           FontFamily="{StaticResource DisplayFontFamily}" 
                           FontSize="12" 
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Row 1 — Content Area -->
            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Step dots -->
                <StackPanel x:Name="StepDotsPanel" Grid.Row="0"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,6,0,0">
                    <Ellipse x:Name="StepDot1" Width="8" Height="8" Fill="#2563EB" Margin="0,0,8,0"/>
                    <Ellipse x:Name="StepDot2" Width="8" Height="8" Fill="#CBD5E1" Margin="0,0,8,0"/>
                    <Ellipse x:Name="StepDot3" Width="8" Height="8" Fill="#CBD5E1" Margin="0,0,8,0"/>
                    <Ellipse x:Name="StepDot4" Width="8" Height="8" Fill="#CBD5E1" Margin="0,0,8,0"/>
                </StackPanel>

                <!-- Step content host -->
                <ContentControl x:Name="StepHost"
                                Grid.Row="1"
                                Margin="48,16,48,28"/>
            </Grid>
        </Grid>
    </Border>
</Window>
